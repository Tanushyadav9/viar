// Prisma Schema for Viar.in Astrology Education Academy
// PostgreSQL Datasource

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
  INSTRUCTOR
}

enum CohortStatus {
  UPCOMING
  ENROLLING
  IN_PROGRESS
  COMPLETED
}

enum MeetingPlatform {
  ZOOM
  GOOGLE_MEET
}

enum ClassStatus {
  UPCOMING
  LIVE
  COMPLETED
}

model User {
  id          String     @id @default(cuid())
  clerkId     String?    @unique
  name        String
  email       String?    @unique
  phone       String?    @unique
  role        UserRole   @default(STUDENT)
  timezone    String     @default("Asia/Kolkata")
  avatarUrl   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  enrollments   Enrollment[]
  submissions   TestSubmission[]
  certificates  Certificate[]
}

model Course {
  id                   String    @id @default(cuid())
  slug                 String    @unique
  title                String
  tagline              String
  subtitle             String
  description          String    @db.Text
  level                String    @default("Beginner")
  durationWeeks        Int
  totalClasses         Int
  classesPerWeek       Int       @default(2)
  priceInr             Int
  priceUsd             Int
  originalPriceInr     Int
  originalPriceUsd     Int
  isPublished          Boolean   @default(true)
  featured             Boolean   @default(false)
  badge                String?
  
  // Instructor Details
  instructorName       String
  instructorTitle      String
  instructorBio        String    @db.Text
  instructorAvatarUrl  String
  instructorAapkaAstroUrl String @default("https://aapkaastro.com")
  
  // Curricular details stored as JSON or relational
  highlights           String[]
  prerequisites        String[]
  whatYouWillLearn     String[]
  
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  cohorts              Cohort[]
}

model Cohort {
  id                   String         @id @default(cuid())
  courseId             String
  course               Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batchNumber          Int
  batchName            String
  startDate            DateTime
  endDate              DateTime
  scheduleDescription  String
  maxSeats             Int            @default(60)
  enrolledCount        Int            @default(0)
  status               CohortStatus   @default(ENROLLING)
  enrollmentDeadline   DateTime?
  
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  classes              ScheduledClass[]
  enrollments          Enrollment[]
  finalTests           FinalTest[]
  testSubmissions      TestSubmission[]
}

model ScheduledClass {
  id                 String           @id @default(cuid())
  cohortId           String
  cohort             Cohort           @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  classNumber        Int
  moduleNumber       Int
  title              String
  subtitle           String?
  description        String           @db.Text
  scheduledStartTime DateTime
  durationMinutes    Int              @default(90)
  meetingPlatform    MeetingPlatform  @default(ZOOM)
  joinUrl            String
  meetingId          String?
  passcode           String?
  status             ClassStatus      @default(UPCOMING)

  recording          ClassRecording?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([cohortId, classNumber])
}

model ClassRecording {
  id                 String           @id @default(cuid())
  classId            String           @unique
  scheduledClass     ScheduledClass   @relation(fields: [classId], references: [id], onDelete: Cascade)
  videoId            String?          // Cloudflare Stream / Mux Asset ID
  videoUrl           String           // Playback / Embed URL
  provider           String           @default("CLOUDFLARE") // CLOUDFLARE | MUX | DIRECT
  durationMinutes    Int
  recordedDate       DateTime         @default(now())
  notesMarkdown      String           @db.Text
  keyTakeaways       String[]
  resourcesJson      String?          @db.Text

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model FinalTest {
  id                 String           @id @default(cuid())
  cohortId           String
  cohort             Cohort           @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  courseId           String
  title              String
  description        String           @db.Text
  passingPercentage  Int              @default(70)
  durationMinutes    Int              @default(45)
  totalQuestions     Int              @default(20)

  questions          TestQuestion[]
  submissions        TestSubmission[]

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model TestQuestion {
  id                 String           @id @default(cuid())
  testId             String
  finalTest          FinalTest        @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionNumber     Int
  topic              String
  question           String           @db.Text
  options            String[]
  correctOptionIndex Int
  explanation        String           @db.Text

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([testId, questionNumber])
}

model TestSubmission {
  id                 String           @id @default(cuid())
  testId             String
  finalTest          FinalTest        @relation(fields: [testId], references: [id], onDelete: Cascade)
  cohortId           String
  cohort             Cohort           @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  studentId          String
  student            User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentName        String
  studentEmail       String
  answersJson        String           @db.Text
  score              Int
  totalQuestions     Int
  scorePercentage    Int
  isPassed           Boolean
  submittedAt        DateTime         @default(now())
  certificateId      String?
}

model Certificate {
  id                 String           @id @default(cuid())
  verificationCode   String           @unique // e.g. VIAR-2026-WIA-9842
  studentId          String
  student            User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentName        String
  studentEmail       String
  courseId           String
  courseTitle        String
  cohortBatchName    String
  issueDate          String
  scorePercentage    Int
  grade              String           // Distinction | Merit | Pass
  instructorName     String
  instructorTitle    String
  verificationUrl    String

  createdAt          DateTime         @default(now())
}

model Enrollment {
  id                 String           @id @default(cuid())
  studentId          String
  student            User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentName        String
  studentEmail       String
  courseId           String
  cohortId           String
  cohort             Cohort           @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  enrolledAt         DateTime         @default(now())
  paymentStatus      String           @default("PAID")
  paymentAmount      Int
  currency           String           @default("INR") // INR | USD
  paymentMethod      String
  paymentId          String
  provider           String           @default("RAZORPAY") // RAZORPAY | STRIPE | MANUAL
}
