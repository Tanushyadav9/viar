// Prisma Schema for Viar.in Astrology Education Academy
// PostgreSQL Datasource

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
  OWNER
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  COMING_SOON
}

enum LessonType {
  VIDEO
  DOCUMENT
  LIVE_SESSION
  QUIZ
}

enum CohortStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum MeetingPlatform {
  ZOOM
  GOOGLE_MEET
}

enum ClassStatus {
  UPCOMING
  LIVE
  COMPLETED
}

enum PaymentProvider {
  UPI_QR
  MANUAL_VERIFICATION
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_CLAIMED
  APPROVED
  REJECTED
  EXPIRED
  REFUNDED
}

enum StaffAccessLevel {
  VIEW
  MANAGE
}

// ------------------------------------------------------------------------------
// 1. USER
// ------------------------------------------------------------------------------

model User {
  id               String            @id @default(cuid())
  role             UserRole          @default(STUDENT)
  isOwner          Boolean           @default(false) @map("is_owner")
  name             String
  email            String?           @unique
  phone            String?           @unique
  country          String?           @default("IN")
  timezone         String            @default("Asia/Kolkata")
  avatarUrl        String?           @map("avatar_url")
  clerkId          String?           @unique @map("clerk_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  // Relations
  enrollments      Enrollment[]
  sessionProgress  SessionProgress[]
  lessonProgress   LessonProgress[]
  quizAttempts     QuizAttempt[]
  certificates     Certificate[]
  payments         Payment[]
  orders           Order[]
  staffPermissions StaffPermission[]

  @@index([role])
  @@index([isOwner])
  @@index([createdAt])
  @@map("users")
}

// ------------------------------------------------------------------------------
// 2. COURSE
// ------------------------------------------------------------------------------

model Course {
  id                 String         @id @default(cuid())
  title              String
  titleHi            String?        @map("title_hi")
  slug               String         @unique
  shortDescription   String?        @db.Text @map("short_description")
  shortDescriptionHi String?        @db.Text @map("short_description_hi")
  description        String         @db.Text
  descriptionHi      String?        @db.Text @map("description_hi")
  syllabusJson       Json?          @map("syllabus_json")
  level              String         @default("Beginner")
  category           String         @default("Vedic Astrology")
  thumbnailUrl       String?        @map("thumbnail_url")
  status             CourseStatus   @default(PUBLISHED)
  isComingSoon       Boolean        @default(false) @map("is_coming_soon")
  displayOrder       Int            @default(0) @map("display_order")
  passingScore       Int            @default(70) @map("passing_score")
  certificateEnabled Boolean        @default(true) @map("certificate_enabled")

  // Tuition & Pricing details
  priceInr           Int            @default(5100) @map("price_inr")
  priceUsd           Int?           @map("price_usd")
  originalPriceInr   Int            @default(11000) @map("original_price_inr")
  originalPriceUsd   Int?           @map("original_price_usd")

  // Curricular helpers
  durationWeeks      Int            @default(9) @map("duration_weeks")
  totalClasses       Int            @default(23) @map("total_classes")
  classesPerWeek     Int            @default(2) @map("classes_per_week")

  // Instructor metadata
  instructorName     String         @default("Acharya Niraj Kumar") @map("instructor_name")
  instructorBio      String?        @db.Text @map("instructor_bio")

  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  // Relations
  modules            Module[]
  quizzes            Quiz[]
  cohorts            Cohort[]
  enrollments        Enrollment[]
  certificates       Certificate[]
  activityLogs       ActivityLog[]
  payments           Payment[]
  orders             Order[]

  @@index([slug])
  @@index([status])
  @@index([displayOrder])
  @@map("courses")
}

// ------------------------------------------------------------------------------
// 2A. MODULE
// Belongs to a course, title, description, order
// ------------------------------------------------------------------------------

model Module {
  id            String   @id @default(cuid())
  courseId      String   @map("course_id")
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title         String
  titleHi       String?  @map("title_hi")
  description   String?  @db.Text
  descriptionHi String?  @db.Text @map("description_hi")
  order         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  lessons     Lesson[]

  @@index([courseId])
  @@index([order])
  @@map("modules")
}

// ------------------------------------------------------------------------------
// 2B. LESSON
// Belongs to a module, order, type (VIDEO / DOCUMENT / LIVE_SESSION / QUIZ), title, description, isFreePreview
// ------------------------------------------------------------------------------

model Lesson {
  id               String          @id @default(cuid())
  moduleId         String          @map("module_id")
  module           Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order            Int             @default(0)
  type             LessonType      @default(VIDEO)
  title            String
  titleHi          String?         @map("title_hi")
  description      String?         @db.Text
  descriptionHi    String?         @db.Text @map("description_hi")
  isFreePreview    Boolean         @default(false) @map("is_free_preview")

  // Type-specific fields
  videoProviderId  String?         @map("video_provider_id") // Cloudflare Stream UID or YouTube/Vimeo ID or URL
  videoDuration    Int?            @map("video_duration") // duration in seconds
  documentKey      String?         @map("document_key") // Cloudflare R2 / S3 file key
  documentUrl      String?         @map("document_url") // Public or presigned preview URL
  liveScheduledAt  DateTime?       @map("live_scheduled_at")
  liveTimezone     String?         @default("Asia/Kolkata") @map("live_timezone")
  liveJoinLink     String?         @map("live_join_link")

  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  // Relations
  quizzes          Quiz[]
  progress         LessonProgress[]

  @@index([moduleId])
  @@index([order])
  @@index([type])
  @@map("lessons")
}

// ------------------------------------------------------------------------------
// 3. COHORT
// ------------------------------------------------------------------------------

model Cohort {
  id                  String         @id @default(cuid())
  courseId            String         @map("course_id")
  course              Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batchName           String         @map("batch_name")
  startDate           DateTime       @map("start_date")
  endDate             DateTime?      @map("end_date")
  capacity            Int            @default(50)
  enrolledCount       Int            @default(0) @map("enrolled_count")
  status              CohortStatus   @default(UPCOMING)
  scheduleDescription String?        @map("schedule_description")

  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  // Relations
  classSessions       ClassSession[]
  enrollments         Enrollment[]
  quizAttempts        QuizAttempt[]
  certificates        Certificate[]
  payments            Payment[]
  orders              Order[]

  @@index([courseId])
  @@index([status])
  @@index([startDate])
  @@map("cohorts")
}

// ------------------------------------------------------------------------------
// 4. CLASS SESSION
// ------------------------------------------------------------------------------

model ClassSession {
  id                  String            @id @default(cuid())
  cohortId            String            @map("cohort_id")
  cohort              Cohort            @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  sessionNumber       Int               @map("session_number")
  title               String
  description         String?           @db.Text
  scheduledAt         DateTime          @map("scheduled_at")
  durationMinutes     Int               @default(90) @map("duration_minutes")
  meetingPlatform     MeetingPlatform   @default(ZOOM) @map("meeting_platform")
  joinLink            String?           @map("join_link")
  meetingId           String?           @map("meeting_id")
  passcode            String?
  recordingUrl        String?           @map("recording_url")
  recordingUploadedAt DateTime?         @map("recording_uploaded_at")
  notesMarkdown       String?           @db.Text @map("notes_markdown")
  status              ClassStatus       @default(UPCOMING)

  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  // Relations
  sessionProgress     SessionProgress[]

  @@unique([cohortId, sessionNumber])
  @@index([cohortId])
  @@index([scheduledAt])
  @@index([status])
  @@map("class_sessions")
}

// ------------------------------------------------------------------------------
// 5. ENROLLMENT (Never cascade deleted)
// ------------------------------------------------------------------------------

model Enrollment {
  id               String        @id @default(cuid())
  userId           String        @map("user_id")
  user             User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  courseId         String?       @map("course_id")
  course           Course?       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  cohortId         String?       @map("cohort_id")
  cohort           Cohort?       @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  paymentId        String?       @map("payment_id")
  payment          Payment?      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  enrolledAt       DateTime      @default(now()) @map("enrolled_at")
  amountPaid       Int           @map("amount_paid")
  currency         String        @default("INR")
  paymentReference String?       @map("payment_reference")
  status           String        @default("ACTIVE") // ACTIVE | ARCHIVED | REVOKED | REFUNDED
  discountAmount   Int?          @default(0) @map("discount_amount")
  order            Order?

  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@unique([userId, cohortId])
  @@index([userId])
  @@index([courseId])
  @@index([cohortId])
  @@index([paymentId])
  @@map("enrollments")
}

// ------------------------------------------------------------------------------
// 6. SESSION PROGRESS & LESSON PROGRESS
// ------------------------------------------------------------------------------

model SessionProgress {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  classSessionId String        @map("class_session_id")
  classSession   ClassSession  @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  watchedAt      DateTime      @default(now()) @map("watched_at")

  @@unique([userId, classSessionId])
  @@index([userId])
  @@index([classSessionId])
  @@index([watchedAt])
  @@map("session_progress")
}

model LessonProgress {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String    @map("lesson_id")
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed      Boolean   @default(false)
  watchedSeconds Int       @default(0) @map("watched_seconds")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// ------------------------------------------------------------------------------
// 7. QUIZ, QUESTION, OPTION
// Scoped to a lesson or course final exam
// ------------------------------------------------------------------------------

model Quiz {
  id                String         @id @default(cuid())
  courseId          String?        @map("course_id")
  course            Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId          String?        @map("lesson_id")
  lesson            Lesson?        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title             String         @default("Certification Assessment")
  questionsJson     Json?          @map("questions_json") // for legacy fallback
  passingPercentage Int            @default(70) @map("passing_percentage")
  passingScore      Int            @default(70) @map("passing_score")
  attemptsAllowed   Int            @default(3) @map("attempts_allowed")
  durationMinutes   Int            @default(45) @map("duration_minutes")
  isFinalExam       Boolean        @default(false) @map("is_final_exam")

  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  // Relations
  questions         Question[]
  attempts          QuizAttempt[]

  @@index([courseId])
  @@index([lessonId])
  @@map("quizzes")
}

model Question {
  id          String   @id @default(cuid())
  quizId      String   @map("quiz_id")
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order       Int      @default(0)
  question    String   @db.Text
  explanation String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  options     Option[]

  @@index([quizId])
  @@index([order])
  @@map("questions")
}

model Option {
  id         String   @id @default(cuid())
  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int      @default(0)
  text       String   @db.Text
  isCorrect  Boolean  @default(false) @map("is_correct")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([questionId])
  @@index([order])
  @@map("options")
}

// ------------------------------------------------------------------------------
// 8. QUIZ ATTEMPT
// ------------------------------------------------------------------------------

model QuizAttempt {
  id              String      @id @default(cuid())
  userId          String      @map("user_id")
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohortId        String?     @map("cohort_id")
  cohort          Cohort?     @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  quizId          String?     @map("quiz_id")
  quiz            Quiz?       @relation(fields: [quizId], references: [id], onDelete: SetNull)
  score           Int
  totalQuestions  Int         @default(20) @map("total_questions")
  scorePercentage Int         @map("score_percentage")
  passed          Boolean
  answersJson     Json?       @map("answers_json")
  attemptedAt     DateTime    @default(now()) @map("attempted_at")

  @@index([userId])
  @@index([cohortId])
  @@index([quizId])
  @@index([passed])
  @@index([attemptedAt])
  @@map("quiz_attempts")
}

// ------------------------------------------------------------------------------
// 9. CERTIFICATE
// ------------------------------------------------------------------------------

model Certificate {
  id                String      @id @default(cuid())
  userId            String      @map("user_id")
  user              User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  courseId          String?     @map("course_id")
  course            Course?     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  cohortId          String?     @map("cohort_id")
  cohort            Cohort?     @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  certificateNumber String      @unique @map("certificate_number")
  verifySlug        String      @unique @map("verify_slug")
  issuedAt          DateTime    @default(now()) @map("issued_at")

  // Certificate metadata
  grade             String?     // Distinction | Merit | Pass
  scorePercentage   Int?        @map("score_percentage")
  pdfUrl            String?     @map("pdf_url")
  instructorName    String      @default("Acharya Niraj Kumar") @map("instructor_name")

  createdAt         DateTime    @default(now()) @map("created_at")

  @@index([userId])
  @@index([courseId])
  @@index([cohortId])
  @@index([certificateNumber])
  @@index([verifySlug])
  @@index([issuedAt])
  @@map("certificates")
}

// ------------------------------------------------------------------------------
// 10. PAYMENT (Never cascade deleted)
// ------------------------------------------------------------------------------

model Payment {
  id                String          @id @default(cuid())
  userId            String          @map("user_id")
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  cohortId          String?         @map("cohort_id")
  cohort            Cohort?         @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  courseId          String?         @map("course_id")
  course            Course?         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  provider          PaymentProvider @default(UPI_QR)
  providerReference String?         @map("provider_reference")
  amount            Int
  currency          String          @default("INR")
  discountAmount    Int?            @default(0) @map("discount_amount")
  status            PaymentStatus   @default(PENDING)
  studentName       String?         @map("student_name")
  studentEmail      String?         @map("student_email")
  studentPhone      String?         @map("student_phone")
  screenshotUrl     String?         @map("screenshot_url")
  notes             String?         @db.Text
  verifiedBy        String?         @map("verified_by")
  verifiedAt        DateTime?       @map("verified_at")

  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  // Relations
  enrollments       Enrollment[]

  @@index([userId])
  @@index([cohortId])
  @@index([courseId])
  @@index([status])
  @@index([providerReference])
  @@index([createdAt])
  @@map("payments")
}

// ------------------------------------------------------------------------------
// 10A. ORDER (Manual UPI Workflow)
// ------------------------------------------------------------------------------

model Order {
  id               String        @id @default(cuid())
  orderReference   String        @unique @map("order_reference")
  userId           String        @map("user_id")
  user             User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  courseId         String        @map("course_id")
  course           Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  cohortId         String?       @map("cohort_id")
  cohort           Cohort?       @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  amount           Int           // Locked price in INR
  currency         String        @default("INR")
  status           OrderStatus   @default(PENDING_PAYMENT)
  studentName      String?       @map("student_name")
  studentEmail     String?       @map("student_email")
  studentPhone     String        @map("student_phone")
  utr              String?       // 12-digit transaction ID
  claimedAt        DateTime?     @map("claimed_at")
  notes            String?       @db.Text
  expiresAt        DateTime      @map("expires_at")
  reviewedBy       String?       @map("reviewed_by")
  reviewedAt       DateTime?     @map("reviewed_at")
  rejectionReason  String?       @db.Text @map("rejection_reason")
  bankConfirmed    Boolean       @default(false) @map("bank_confirmed")
  refundedAt       DateTime?     @map("refunded_at")
  refundReason     String?       @db.Text @map("refund_reason")
  enrollmentId     String?       @unique @map("enrollment_id")
  enrollment       Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@index([courseId])
  @@index([cohortId])
  @@index([status])
  @@index([orderReference])
  @@index([utr])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("orders")
}

// ------------------------------------------------------------------------------
// 10B. PAYMENT SETTINGS (Owner-editable in DB)
// ------------------------------------------------------------------------------

model PaymentSettings {
  id              String   @id @default("default")
  upiId           String   @default("aapkaastro@okaxis") @map("upi_id")
  payeeName       String   @default("Vihangam Institute of Astrology and Research") @map("payee_name")
  qrImageUrl      String?  @map("qr_image_url")
  whatsappNumber  String   @default("919311215564") @map("whatsapp_number")
  orderExpiryDays Int      @default(3) @map("order_expiry_days")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedBy       String?  @map("updated_by")

  @@map("payment_settings")
}

// ------------------------------------------------------------------------------
// 11. NOTIFY ME LEAD
// ------------------------------------------------------------------------------

model NotifyMeLead {
  id         String   @id @default(cuid())
  email      String
  courseSlug String   @map("course_slug")
  name       String?
  phone      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([courseSlug])
  @@map("notify_me_leads")
}

// ------------------------------------------------------------------------------
// 14. STAFF PERMISSION (Per-Section RBAC)
// ------------------------------------------------------------------------------

model StaffPermission {
  id              String           @id @default(cuid())
  userId          String           @map("user_id")
  section         String
  accessLevel     StaffAccessLevel @default(MANAGE) @map("access_level")
  grantedByUserId String           @map("granted_by_user_id")
  grantedAt       DateTime         @default(now()) @map("granted_at")
  revokedAt       DateTime?        @map("revoked_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([section])
  @@index([revokedAt])
  @@map("staff_permissions")
}

// ------------------------------------------------------------------------------
// 15. ACTIVITY & AUDIT LOG
// Records all administrative actions, who changed what, and required reasons
// ------------------------------------------------------------------------------

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  userEmail  String?  @map("user_email")
  userName   String?  @map("user_name")
  action     String   @map("action")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  reason     String?  @db.Text
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  courseId   String?  @map("course_id")
  course     Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

// ------------------------------------------------------------------------------
// 16. CLERK WEBHOOK EVENT LOG
// Audit table tracking all incoming Clerk webhook dispatches for diagnostics
// ------------------------------------------------------------------------------

model ClerkWebhookEvent {
  id           String    @id @default(cuid())
  eventId      String?   @map("event_id")
  eventType    String    @map("event_type")
  payload      Json?
  status       String    @default("PROCESSED") // PROCESSED | ERROR
  errorMessage String?   @map("error_message") @db.Text
  receivedAt   DateTime  @default(now()) @map("received_at")

  @@index([eventType])
  @@index([receivedAt])
  @@map("clerk_webhook_events")
}

