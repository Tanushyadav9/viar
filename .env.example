# ==============================================================================
# VIAR.IN ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# All secrets and provider tokens must be defined here.
# For local development, copy this file to .env.local:
#   cp .env.example .env.local
# ==============================================================================

# Application URL
# In local development: http://localhost:3000
# In production: https://viar.in
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL on Neon Free Tier — https://neon.tech)
# ------------------------------------------------------------------------------
# Neon PostgreSQL (Free Tier) is the selected production database provider.
# RATIONALE OVER SUPABASE:
# - Neon scales to zero when idle and AUTO-RESUMES seamlessly upon the next request.
# - Supabase free tier PAUSES projects after 7 days of inactivity, causing unexpected
#   outages unless manually unpaused from their dashboard.
# - Neon's 3 GiB free storage is ample (videos and images are hosted on Cloudflare).
#
# A) RUNTIME POOLED CONNECTION (DATABASE_URL):
# Must use Neon's POOLED connection string (via PgBouncer, with "-pooler" in host).
# Crucial for Vercel Serverless Functions to prevent exhausting connection limits:
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/viar_db?schema=public"

# B) DIRECT MIGRATION CONNECTION (DIRECT_URL):
# Direct (unpooled) connection string without "-pooler".
# Required by Prisma CLI for running "npx prisma migrate deploy" (DDL migrations & advisory locks):
# Format: postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require
DIRECT_URL=""

# ------------------------------------------------------------------------------
# 2. CACHE & SCHEDULING (Redis)
# ------------------------------------------------------------------------------
# Connection string for Redis instance (hosted on Railway, Upstash, or Render).
# Used for class schedule caching, seat counts, and rate limiting.
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (Clerk Multi-Domain / Satellite SSO)
# ------------------------------------------------------------------------------
# Viar.in uses Clerk configured for multi-domain / satellite SSO so students who
# log in on viar.in can later be recognized on aapkaastro.com and dowconsulting.in.
# Primary Domain: aapkaastro.com
# Satellite Domains: viar.in, dowconsulting.in
# Obtain keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_CLERK_DOMAIN="viar.in"
NEXT_PUBLIC_CLERK_IS_SATELLITE="true"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="https://aapkaastro.com/sign-in"

# ------------------------------------------------------------------------------
# 4. EMAIL SIGN-UP POLICY (Anti-Abuse / Domain Restrictions)
# ------------------------------------------------------------------------------
# Configurable sign-up restriction policy with two switchable modes:
#
# MODE 1: "BLOCKLIST" (RECOMMENDED DEFAULT)
#   Permits any real email address (including Gmail, Yahoo, Outlook, iCloud,
#   corporate/work emails, university addresses), but BLOCKS known disposable/
#   temporary email domains (e.g. mailinator.com, tempmail.com, 10minutemail.com,
#   yopmail.com, throwawaymail.com). Achieves anti-abuse protection without
#   turning away legitimate paying students who use non-Gmail providers.
#
# MODE 2: "ALLOWLIST"
#   Strictly restricts sign-ups to explicitly listed domains (e.g. gmail.com,
#   yahoo.com). Simple, but blocks legitimate students on corporate domains,
#   iCloud, or university accounts unless their domain is explicitly added.
#
# Switch mode here ("BLOCKLIST" or "ALLOWLIST"):
EMAIL_SIGNUP_POLICY_MODE="BLOCKLIST"

# Comma-separated domains for ALLOWLIST mode (used when mode is ALLOWLIST):
EMAIL_SIGNUP_ALLOWLIST="gmail.com,yahoo.com,outlook.com,hotmail.com,icloud.com,proton.me,protonmail.com,live.com,aol.com,zoho.com"

# Additional custom domains to block in BLOCKLIST mode (optional):
EMAIL_SIGNUP_BLOCKLIST_EXTRA=""

# NOTE ON CLERK DASHBOARD RESTRICTIONS (Native API Enforcement):
# Clerk natively supports domain restrictions to prevent direct API bypass.
# In production, match this setting in your Clerk Dashboard:
# 1. Open Clerk Dashboard (https://dashboard.clerk.com) -> Users & Authentication.
# 2. Select "Email, Phone, Username" -> Click settings icon next to "Email Address".
# 3. Under "Restrictions", choose:
#    - "Blocklist": Paste disposable domains or spam domains.
#    - "Allowlist": Enter approved domains (if using ALLOWLIST mode).

# ------------------------------------------------------------------------------
# 4. PAYMENTS: RAZORPAY (India - Live at Launch)
# ------------------------------------------------------------------------------
# Razorpay handles domestic payments for Indian students (UPI, Netbanking, Cards).
# Live at launch. Obtain from https://dashboard.razorpay.com
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"

# ------------------------------------------------------------------------------
# 5. PAYMENTS: STRIPE (International)
# ------------------------------------------------------------------------------
# Stripe handles international student card payments in USD/foreign currencies.
# NOTE: Set ENABLE_STRIPE="false" until the client finishes Stripe's Indian business registration.
# The checkout flow will gracefully offer ONLY Razorpay when ENABLE_STRIPE="false" or keys are empty.
ENABLE_STRIPE="false"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 6. VIDEO HOSTING (Class Recordings)
# ------------------------------------------------------------------------------
# Abstracted behind the VideoHostingService interface.
# Supported values: "cloudflare" | "mux" | "direct"
VIDEO_HOSTING_PROVIDER="cloudflare"

# Cloudflare Stream credentials (recommended):
# https://dash.cloudflare.com/ -> Stream
CLOUDFLARE_STREAM_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=""

# Mux Video credentials (alternative):
# https://dashboard.mux.com
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
