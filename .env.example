# ==============================================================================
# VIAR.IN ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# All secrets and provider tokens must be defined here.
# For local development, copy this file to .env.local:
#   cp .env.example .env.local
# ==============================================================================

# Application URL
# In local development: http://localhost:3000
# In production: https://viar.in
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string for PostgreSQL (hosted on Railway, Render, Supabase, or Neon).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/viar_db?schema=public"

# ------------------------------------------------------------------------------
# 2. CACHE & SCHEDULING (Redis)
# ------------------------------------------------------------------------------
# Connection string for Redis instance (hosted on Railway, Upstash, or Render).
# Used for class schedule caching, seat counts, and rate limiting.
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (Clerk Multi-Domain / Satellite SSO)
# ------------------------------------------------------------------------------
# Viar.in uses Clerk configured for multi-domain / satellite SSO so students who
# log in on viar.in can later be recognized on aapkaastro.com and dowconsulting.in.
# Primary Domain: aapkaastro.com
# Satellite Domains: viar.in, dowconsulting.in
# Obtain keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_CLERK_DOMAIN="viar.in"
NEXT_PUBLIC_CLERK_IS_SATELLITE="true"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="https://aapkaastro.com/sign-in"

# ------------------------------------------------------------------------------
# 4. PAYMENTS: RAZORPAY (India - Live at Launch)
# ------------------------------------------------------------------------------
# Razorpay handles domestic payments for Indian students (UPI, Netbanking, Cards).
# Live at launch. Obtain from https://dashboard.razorpay.com
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"

# ------------------------------------------------------------------------------
# 5. PAYMENTS: STRIPE (International)
# ------------------------------------------------------------------------------
# Stripe handles international student card payments in USD/foreign currencies.
# NOTE: Set ENABLE_STRIPE="false" until the client finishes Stripe's Indian business registration.
# The checkout flow will gracefully offer ONLY Razorpay when ENABLE_STRIPE="false" or keys are empty.
ENABLE_STRIPE="false"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 6. VIDEO HOSTING (Class Recordings)
# ------------------------------------------------------------------------------
# Abstracted behind the VideoHostingService interface.
# Supported values: "cloudflare" | "mux" | "direct"
VIDEO_HOSTING_PROVIDER="cloudflare"

# Cloudflare Stream credentials (recommended):
# https://dash.cloudflare.com/ -> Stream
CLOUDFLARE_STREAM_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=""

# Mux Video credentials (alternative):
# https://dashboard.mux.com
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
