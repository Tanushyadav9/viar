# ==============================================================================
# VIAR.IN ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# All secrets and provider tokens must be defined here.
# For local development, copy this file to .env.local:
#   cp .env.example .env.local
# ==============================================================================

# Application & Canonical Site URL
# NEXT_PUBLIC_SITE_URL defines the single canonical host for 308 redirects and Open Graph / SEO metadata.
# In local development: http://localhost:3000
# In production: https://viar.in
NEXT_PUBLIC_SITE_URL="https://viar.in"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL on Neon Free Tier — https://neon.tech)
# ------------------------------------------------------------------------------
# Neon PostgreSQL (Free Tier) is the selected production database provider.
#
# A) RUNTIME POOLED CONNECTION (DATABASE_URL):
# Must use Neon's POOLED connection string (via PgBouncer, with "-pooler" in host).
# Crucial for Vercel Serverless Functions to prevent exhausting connection limits:
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://neondb_owner:your_password_here@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# B) DIRECT MIGRATION CONNECTION (DIRECT_URL):
# Direct (unpooled) connection string without "-pooler".
# Required by Prisma CLI for running "npx prisma migrate deploy" (DDL migrations & advisory locks):
# Format: postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require
DIRECT_URL="postgresql://neondb_owner:your_password_here@ep-direct.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. CACHE & SCHEDULING (Redis)
# ------------------------------------------------------------------------------
# Connection string for Redis instance (hosted on Railway, Upstash, or Render).
# Used for class schedule caching, seat counts, and rate limiting.
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (Clerk Standalone Application)
# ------------------------------------------------------------------------------
# Viar.in uses its own standalone Clerk application with zero shared satellite login.
#
# CRITICAL CLERK KEY ENVIRONMENT SEPARATION:
# - PRODUCTION ENVIRONMENT (Vercel Production Domain: viar.in):
#   MUST use Clerk LIVE keys:
#     NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
#     CLERK_SECRET_KEY="sk_live_..."
#
# - PREVIEW & DEVELOPMENT ENVIRONMENTS (Localhost / Vercel Preview):
#   MUST use Clerk TEST keys:
#     NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
#     CLERK_SECRET_KEY="sk_test_..."
#
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key_here"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key_here"
CLERK_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# SITE OWNER RECOGNITION (Strict Fail-Closed):
# Evaluated server-side from the signed-in user's verified primary email.
# Non-matching emails fail-closed with zero hardcoded bypasses.
OWNER_EMAIL="aapkaastro1606@gmail.com"
SUPERADMIN_EMAILS=""

# ------------------------------------------------------------------------------
# 4. EMAIL SIGN-UP POLICY (Anti-Abuse / Domain Restrictions)
# ------------------------------------------------------------------------------
EMAIL_SIGNUP_POLICY_MODE="BLOCKLIST"
EMAIL_SIGNUP_ALLOWLIST="gmail.com,yahoo.com,outlook.com,hotmail.com,icloud.com,proton.me,protonmail.com,live.com,aol.com,zoho.com"
EMAIL_SIGNUP_BLOCKLIST_EXTRA=""

# ------------------------------------------------------------------------------
# 5. PAYMENTS: DIRECT UPI QR (Zero Gateway Commission Fees)
# ------------------------------------------------------------------------------
# Payments are received directly via UPI QR to avoid 2-3% gateway commissions.
# Students scan the QR code (or pay to UPI ID), submit the transaction reference,
# and send payment screenshot to the Site Owner on WhatsApp (+91 93112 15564).
# Once verified in Owner Studio, the student's own account immediately unlocks.
UPI_VPA="aapkaastro@okaxis"
UPI_PAYEE_NAME="Vihangam Institute of Astrology and Research"
OWNER_WHATSAPP="919311215564"
DEFAULT_TUITION_INR="5100"

# ------------------------------------------------------------------------------
# 6. VIDEO HOSTING (Class Recordings)
# ------------------------------------------------------------------------------
# Supported values: "cloudflare" | "mux" | "direct"
VIDEO_HOSTING_PROVIDER="cloudflare"
CLOUDFLARE_STREAM_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=""
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""

# ------------------------------------------------------------------------------
# 7. AI CHATBOT ASSISTANT & COST CONTROLS (/api/chat)
# ------------------------------------------------------------------------------
# All AI model calls are securely proxied through the server route /api/chat.
# The API key lives ONLY on the server and is NEVER sent to the client browser.
#
# SUPPORTED PROVIDERS:
# 1. Google Gemini (Recommended for cost & speed):
#    - Provider: "gemini" or "google" (Auto-detected if key starts with "AIzaSy")
#    - Model: "gemini-1.5-flash" (or "gemini-2.0-flash")
#    - Data Privacy: Paid Google Cloud / Vertex / AI Studio Paid tier disables training on customer prompts.
# 2. OpenAI:
#    - Provider: "openai"
#    - Model: "gpt-4o-mini"
#    - Data Privacy: Under OpenAI's commercial terms, API data is not used for training.
# 3. Neon AI Gateway:
#    - Provider: "neon"
# 4. Mock / Testing:
#    - Provider: "mock"
#
# PRODUCTION SAFETY GUARD: If CHATBOT_API_KEY is missing in production, the floating
# widget will NOT render, and a warning will be logged. Never shows a broken bot.
# HARD SPENDING BACKSTOP: Set a monthly budget/spending cap ($5 - $10) in your provider's dashboard.
#
CHATBOT_PROVIDER="gemini"
CHATBOT_MODEL="gemini-1.5-flash"
CHATBOT_API_KEY=""
CHATBOT_BASE_URL=""
CHATBOT_DAILY_MESSAGE_CAP="1000"
CHATBOT_HASH_SALT="viar_ai_salt_2026_strict_privacy"


